# URL backend PRODUKSI (dipakai saat EAS build production/preview).
# Ganti dengan domain publik backend sebelum build rilis.
# Profil eas.json menimpa nilai ini saat build (lihat eas.json),
# jadi file ini pegangan lokal agar `npx expo start --no-dev --minify` bisa diuji.
EXPO_PUBLIC_API_URL=https://GANTI-DOMAIN-ANDA
