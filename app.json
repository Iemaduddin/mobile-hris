{
  "expo": {
    "name": "HRIS",
    "slug": "hris",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c0d46a5-74cc-4154-9f7a-3e7b6c075d3b"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hrismobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hris.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.hris.mobile",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikasi HRIS menggunakan lokasi Anda untuk mencatat presensi di area kantor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi HRIS mengakses galeri Anda untuk melampirkan berkas pada pengajuan."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c0d46a5-74cc-4154-9f7a-3e7b6c075d3b"
      }
    },
    "owner": "rafiffakhri"
  }
}
